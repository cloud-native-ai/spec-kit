    @requires_fixtures
    def test_concurrent_refreshes_yield_exactly_one_current_summary(two_teams: Path) -> None:
        """SC-015 — one current summary, zero lost updates, zero half-written state."""
        with ThreadPoolExecutor(max_workers=2) as pool:
