    def test_c2_no_project_side_classification_store():
        offenders: list[str] = []
        for path in sorted(MEMORY_DIR.rglob("*")):
            if not path.is_file():
                continue
            rel = path.relative_to(REPO_ROOT).as_posix()
            if CLASS_FILE_NAME_RE.search(path.name):
                offenders.append("%s — classification-named file" % rel)
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except (UnicodeDecodeError, OSError):
                continue
            for number, line in enumerate(text.splitlines(), 1):
                if LEDGER_ROW_RE.match(line):
                    offenders.append("%s:%d — ledger-style unit/class row" % (rel, number))
                elif CLASS_ASSIGN_RE.search(line):
                    offenders.append("%s:%d — flow_class assignment" % (rel, number))
>       assert not offenders, (
            "C-2: no classification data may be stored project-side (the ledger is "
            "the owner document, delivered with shared/). found:\n- "
            + "\n- ".join(offenders)
        )
E       AssertionError: C-2: no classification data may be stored project-side (the ledger is the owner document, delivered with shared/). found:
E         - .specify/memory/features/088.md:62 — flow_class assignment
E         - .specify/memory/features.md:96 — flow_class assignment
E       assert not ['.specify/memory/features/088.md:62 — flow_class assignment', '.specify/memory/features.md:96 — flow_class assignment']

