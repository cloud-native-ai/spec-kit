    "failure": "Rows that close on one of the four failure classes, each carrying that class's required report items (SC-009)."
  },
  "row_schema": {
    "segment": "surface | normalize | failure — the three segments are disjoint",
    "id": "R<NN>",
    "raw": "the reference exactly as received",
    "form": "one of the six accepted forms, or 'cli' for the NP-1 operation form",
    "operation": "invocation | cli (NP-1; default invocation)",
    "repo_root": "live | scratch | none — where NP-7 reads; 'scratch' rows are materialised under tmp_path by the module that reads them",
    "scratch": "scratch rows only: {layer: {skill-name: {frontmatter, body}}, unreadable: [skill-name], dirs?: {layer: directory}} — dirs overrides the layer directory for one row",
    "exercises": "the form or variation this row is here to prove",
    "expect": "the closed three-valued expectation, paired with the raw identifier"
  },
